## 6. One-Tap Home Screen Pinning Flow

To eliminate the friction of manually finding and dragging a widget from the launcher picker, `MainActivity` provides a single-tap direct pin action via `AppWidgetManager.requestPinAppWidget()`.

```kotlin
package com.best.deskclock.ui

import android.app.PendingIntent
import android.appwidget.AppWidgetManager
import android.content.ComponentName
import android.content.Context
import android.content.Intent
import android.os.Build
import android.widget.Toast
import com.best.deskclock.widget.LiveClockWidgetProvider

object LiveIconInstaller {

    fun pinLiveMicroTile(context: Context) {
        val appWidgetManager = context.getSystemService(AppWidgetManager::class.java)
        val myProvider = ComponentName(context, LiveClockWidgetProvider::class.java)

        if (appWidgetManager.isRequestPinAppWidgetSupported) {
            val successCallback = PendingIntent.getBroadcast(
                context,
                0,
                Intent(context, LiveWidgetPinnedReceiver::class.java),
                PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_MUTABLE
            )

            // Prompts native OS dialog to place the 1x1 tile directly on the home screen
            appWidgetManager.requestPinAppWidget(myProvider, null, successCallback)
        } else {
            Toast.makeText(context, "Automatic pinning not supported by your launcher", Toast.LENGTH_SHORT).show()
        }
    }
}

