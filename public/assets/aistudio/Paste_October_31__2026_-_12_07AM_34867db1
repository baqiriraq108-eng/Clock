## 5. Tier 3: In-App 60fps Smooth Hardware Rendering

Inside the application (`ClockFragment`, `FirstLaunch`, and `AboutScreen`), the Model 3 clock renders at full display resolution with a continuous, fluid 60fps sweeping blue second hand.

### High-Precision Custom View: `Model3ClockView.kt`

```kotlin
package com.best.deskclock.ui.view

import android.content.Context
import android.graphics.*
import android.os.SystemClock
import android.text.format.DateFormat
import android.util.AttributeSet
import android.view.Choreographer
import android.view.View
import java.util.Calendar

class Model3ClockView @JvmOverloads constructor(
    context: Context,
    attrs: AttributeSet? = null,
    defStyleAttr: Int = 0
) : View(context, attrs, defStyleAttr), Choreographer.FrameCallback {

    private val renderer = Model3ClockRenderer()
    private val calendar: Calendar = Calendar.getInstance()
    private var isAnimating = false

    override fun onAttachedToWindow() {
        super.onAttachedToWindow()
        startAnimation()
    }

    override fun onDetachedFromWindow() {
        super.onDetachedFromWindow()
        stopAnimation()
    }

    override fun onVisibilityAggregated(isVisible: Boolean) {
        super.onVisibilityAggregated(isVisible)
        if (isVisible) startAnimation() else stopAnimation()
    }

    private fun startAnimation() {
        if (!isAnimating && isShown) {
            isAnimating = true
            Choreographer.getInstance().postFrameCallback(this)
        }
    }

    private fun stopAnimation() {
        if (isAnimating) {
            isAnimating = false
            Choreographer.getInstance().removeFrameCallback(this)
        }
    }

    override fun doFrame(frameTimeNanos: Long) {
        if (!isAnimating) return
        invalidate()
        Choreographer.getInstance().postFrameCallback(this)
    }

    override fun onDraw(canvas: Canvas) {
        super.onDraw(canvas)
        val now = System.currentTimeMillis()
        calendar.timeInMillis = now

        val hours = calendar.get(Calendar.HOUR_OF_DAY)
        val minutes = calendar.get(Calendar.MINUTE)
        val seconds = calendar.get(Calendar.SECOND)
        val millis = (now % 1000).toInt()
        val is24Hour = DateFormat.is24HourFormat(context)

        renderer.draw(
            canvas = canvas,
            width = width.toFloat(),
            height = height.toFloat(),
            hours = hours,
            minutes = minutes,
            seconds = seconds,
            millis = millis,
            is24Hour = is24Hour
        )
    }
}

```

### Core Canvas Engine: `Model3ClockRenderer.kt`

```kotlin
package com.best.deskclock.ui.view

import android.graphics.*
import kotlin.math.cos
import kotlin.math.sin

class Model3ClockRenderer {

    private val containerPaint = Paint(Paint.ANTI_ALIAS_FLAG)
    private val arrowPaint = Paint(Paint.ANTI_ALIAS_FLAG)
    private val dialRingPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { style = Paint.Style.STROKE }
    private val dialFacePaint = Paint(Paint.ANTI_ALIAS_FLAG)
    private val handPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { strokeCap = Paint.Cap.ROUND }
    private val secondHandPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply { strokeCap = Paint.Cap.ROUND }
    private val bubblePaint = Paint(Paint.ANTI_ALIAS_FLAG)
    private val textPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
        color = Color.parseColor("#F0FDFA")
        typeface = Typeface.create(Typeface.SANS_SERIF, Typeface.BOLD)
        textAlign = Paint.Align.CENTER
    }

    fun draw(
        canvas: Canvas,
        width: Float,
        height: Float,
        hours: Int,
        minutes: Int,
        seconds: Int,
        millis: Int,
        is24Hour: Boolean
    ) {
        val size = width.coerceAtMost(height)
        val cx = width / 2f
        val cy = height / 2f
        val radius = size * 0.48f

        // 1. Render Squircle Container with Diagonal Royal Navy Gradient
        containerPaint.shader = LinearGradient(
            cx - radius, cy - radius, cx + radius, cy + radius,
            Color.parseColor("#1B3B8B"), Color.parseColor("#0A1945"),
            Shader.TileMode.CLAMP
        )
        val squircleRect = RectF(cx - radius, cy - radius, cx + radius, cy + radius)
        canvas.drawRoundRect(squircleRect, size * 0.24f, size * 0.24f, containerPaint)

        // 2. Render Directional L-Arrow (Upper-Left)
        drawOrangeLArrow(canvas, cx, cy, size)

        // 3. Render Analog Dial at Center (63.5%, 47.0%)
        val dialCenterX = cx - radius + (size * 0.96f * 0.635f)
        val dialCenterY = cy - radius + (size * 0.96f * 0.470f)
        val dialRadius = size * 0.27f

        // Beveled Lavender/Periwinkle Outer Ring
        dialRingPaint.strokeWidth = size * 0.038f
        dialRingPaint.shader = LinearGradient(
            dialCenterX - dialRadius, dialCenterY - dialRadius,
            dialCenterX + dialRadius, dialCenterY + dialRadius,
            Color.parseColor("#B8CAFF"), Color.parseColor("#637CE6"),
            Shader.TileMode.CLAMP
        )
        canvas.drawCircle(dialCenterX, dialCenterY, dialRadius, dialRingPaint)

        // Midnight Blue Dial Face
        dialFacePaint.color = Color.parseColor("#0A1633")
        canvas.drawCircle(dialCenterX, dialCenterY, dialRadius - (dialRingPaint.strokeWidth / 2f), dialFacePaint)

        // 4. Calculate Precise Hand Angles with Sub-Millisecond Smoothing
        val smoothSeconds = seconds + (millis / 1000f)
        val smoothMinutes = minutes + (smoothSeconds / 60f)
        val smoothHours = (hours % 12) + (smoothMinutes / 60f)

        val hourAngle = Math.toRadians((smoothHours * 30.0) - 90.0)
        val minuteAngle = Math.toRadians((smoothMinutes * 6.0) - 90.0)
        val secondAngle = Math.toRadians((smoothSeconds * 6.0) - 90.0)

        // Draw Hour Hand (White Rounded-Cap)
        handPaint.color = Color.parseColor("#F8FAFF")
        handPaint.strokeWidth = size * 0.024f
        val hourLength = dialRadius * 0.52f
        canvas.drawLine(
            dialCenterX, dialCenterY,
            dialCenterX + (hourLength * cos(hourAngle)).toFloat(),
            dialCenterY + (hourLength * sin(hourAngle)).toFloat(),
            handPaint
        )

        // Draw Minute Hand (White Rounded-Cap)
        handPaint.strokeWidth = size * 0.018f
        val minLength = dialRadius * 0.76f
        canvas.drawLine(
            dialCenterX, dialCenterY,
            dialCenterX + (minLength * cos(minuteAngle)).toFloat(),
            dialCenterY + (minLength * sin(minuteAngle)).toFloat(),
            handPaint
        )

        // Draw Blue Sweeping Second Hand (60fps) + Counterweight Tail
        secondHandPaint.color = Color.parseColor("#2979FF")
        secondHandPaint.strokeWidth = size * 0.010f
        val secLength = dialRadius * 0.85f
        val tailLength = dialRadius * 0.22f
        canvas.drawLine(
            dialCenterX - (tailLength * cos(secondAngle)).toFloat(),
            dialCenterY - (tailLength * sin(secondAngle)).toFloat(),
            dialCenterX + (secLength * cos(secondAngle)).toFloat(),
            dialCenterY + (secLength * sin(secondAngle)).toFloat(),
            secondHandPaint
        )
        // Center Blue Pivot Cap
        canvas.drawCircle(dialCenterX, dialCenterY, size * 0.018f, secondHandPaint)

        // 5. Render Organic Mint Green Pebble Bubble (Lower-Left)
        drawOrganicGreenBubble(canvas, cx, cy, size, hours, minutes, is24Hour)
    }

    private fun drawOrangeLArrow(canvas: Canvas, cx: Float, cy: Float, size: Float) {
        val arrowPath = Path().apply {
            val startX = cx - (size * 0.38f)
            val startY = cy - (size * 0.12f)
            moveTo(startX, startY)
            lineTo(startX, cy - (size * 0.36f))
            lineTo(startX + (size * 0.24f), cy - (size * 0.36f))
            lineTo(startX + (size * 0.24f), cy - (size * 0.26f))
            lineTo(startX + (size * 0.10f), cy - (size * 0.26f))
            lineTo(startX + (size * 0.10f), startY)
            close()
        }
        arrowPaint.shader = LinearGradient(
            cx - (size * 0.38f), cy - (size * 0.36f),
            cx - (size * 0.14f), cy - (size * 0.12f),
            Color.parseColor("#FFDF5D"), Color.parseColor("#F46800"),
            Shader.TileMode.CLAMP
        )
        canvas.drawPath(arrowPath, arrowPaint)
    }

    private fun drawOrganicGreenBubble(
        canvas: Canvas,
        cx: Float,
        cy: Float,
        size: Float,
        hours: Int,
        minutes: Int,
        is24Hour: Boolean
    ) {
        val bubbleCenterX = cx - (size * 0.18f)
        val bubbleCenterY = cy + (size * 0.22f)
        val bubbleWidth = size * 0.36f
        val bubbleHeight = size * 0.24f

        bubblePaint.shader = RadialGradient(
            bubbleCenterX - (bubbleWidth * 0.2f),
            bubbleCenterY - (bubbleHeight * 0.2f),
            bubbleWidth * 0.8f,
            Color.parseColor("#68F2D0"),
            Color.parseColor("#0D9488"),
            Shader.TileMode.CLAMP
        )

        val bubbleRect = RectF(
            bubbleCenterX - (bubbleWidth / 2f),
            bubbleCenterY - (bubbleHeight / 2f),
            bubbleCenterX + (bubbleWidth / 2f),
            bubbleCenterY + (bubbleHeight / 2f)
        )
        canvas.drawRoundRect(bubbleRect, bubbleHeight * 0.45f, bubbleHeight * 0.45f, bubblePaint)

        // Draw Centered Digital Time String
        val displayHours = if (is24Hour) {
            String.format("%02d", hours)
        } else {
            val h = if (hours % 12 == 0) 12 else hours % 12
            h.toString()
        }
        val timeString = "$displayHours:${String.format("%02d", minutes)}"

        textPaint.textSize = size * 0.085f
        val textY = bubbleCenterY - ((textPaint.descent() + textPaint.ascent()) / 2f)
        canvas.drawText(timeString, bubbleCenterX, textY, textPaint)
    }
}

```

